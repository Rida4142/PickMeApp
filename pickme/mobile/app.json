{
  "expo": {
    "name": "PickMe",
    "slug": "pickme",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#FFF9EC",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFF9EC",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.pickme.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "PickMe accesses your selected photos to set your profile picture."
        }
      ]
    ]
  }
}
